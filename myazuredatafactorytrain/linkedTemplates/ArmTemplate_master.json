{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "myazuredatafactorytrain"
		},
		"ls_adls_parquet_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_parquet'"
		},
		"ls_blob_excel_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_blob_excel'"
		},
		"ls_onprem_sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_onprem_sql'"
		},
		"ls_sql_azure_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_azure'"
		},
		"ls_adls_parquet_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen2storgeac.dfs.core.windows.net/"
		},
		"ls_onprem_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "LAPTOP-0L80BMJ2"
		},
		"ls_onprem_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2019"
		},
		"ls_onprem_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "srinu"
		},
		"ls_sql_azure_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "myserverfortraining.database.windows.net"
		},
		"ls_sql_azure_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Sample"
		},
		"ls_sql_azure_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "srinu"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "myazuredatafactorytrain_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_parquet_accountKey": {
						"value": "[parameters('ls_adls_parquet_accountKey')]"
					},
					"ls_blob_excel_connectionString": {
						"value": "[parameters('ls_blob_excel_connectionString')]"
					},
					"ls_sql_azure_password": {
						"value": "[parameters('ls_sql_azure_password')]"
					},
					"ls_onprem_sql_password": {
						"value": "[parameters('ls_onprem_sql_password')]"
					},
					"ls_adls_parquet_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_parquet_properties_typeProperties_url')]"
					},
					"ls_sql_azure_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_azure_properties_typeProperties_server')]"
					},
					"ls_sql_azure_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_azure_properties_typeProperties_database')]"
					},
					"ls_sql_azure_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_azure_properties_typeProperties_userName')]"
					},
					"ls_onprem_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_onprem_sql_properties_typeProperties_server')]"
					},
					"ls_onprem_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_onprem_sql_properties_typeProperties_database')]"
					},
					"ls_onprem_sql_properties_typeProperties_userName": {
						"value": "[parameters('ls_onprem_sql_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}